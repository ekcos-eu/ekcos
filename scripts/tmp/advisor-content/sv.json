      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "p-traffic-1a",
          "_type": "span",
          "marks": [],
          "text": "Börja med besöksfrekvensen. Ju fler besökare, desto mer måste mattan klara."
        }
