          "_type": "span",
          "marks": [],
          "text": "powër screen : picots anti-éclaboussures brevetés."
        }
      ]
    },
    {
      "_key": "b-splash-uro",
      "_type": "block",
      "style": "normal",
      "listItem": "bullet",
      "level": 1,
      "markDefs": [],
      "children": [
        {
          "_key": "b-splash-uroa",
          "_type": "span",
          "marks": [],
          "text": "üro lite : de longs picots brevetés offrent une grande protection anti-éclaboussures dans une petite grille."
        }
      ]
