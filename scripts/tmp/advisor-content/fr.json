      ]
    },
    {
      "_key": "p-evidence-used",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "p-evidence-useda",
          "_type": "span",
          "marks": [],
          "text": "Une grille usagée est contaminée biologiquement et ne peut pas être recyclée : elle finit donc en décharge ou à l'incinération. En décharge, Eco-One™ la rend biodégradable."
        }
      ]
    },
    {
      "_key": "p-evidence-ask",
      "_type": "block",
      "style": "normal",
      "markDefs": [],
      "children": [
        {
          "_key": "p-evidence-aska",
