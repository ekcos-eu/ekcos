        "custom_liquid_YrNjX7": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% assign variant = product.selected_or_first_available_variant %}\n{% assign price = variant.price %}\n\n{% comment %} Načti prahy z metafieldů, fallback na původní hodnoty {% endcomment %}\n{% assign tier1_qty = product.metafields.custom.discount_tier1_qty | default: 6 %}\n{% assign tier2_qty = product.metafields.custom.discount_tier2_qty | default: 12 %}\n\n{% assign tier1_max = tier2_qty | minus: 1 %}\n{% assign bulk_qty = tier2_qty | times: 2 %}\n\n{% assign price_10 = price | times: 0.90 | money %}\n{% assign price_15 = price | times: 0.80 | money %}\n\n{% assign has_unit_price = false %}\n{% if variant.unit_price %}\n  {% assign has_unit_price = true %}\n  {% assign unit_price_10 = variant.unit_price | times: 0.90 | money %}\n  {% assign unit_price_15 = variant.unit_price | times: 0.80 | money %}\n{% endif %}\n\n<div class=\"quantity-discount-table\">\n  <table>\n    <thead>\n      <tr>\n        <th>{{ 'products.product.qty_range' | t }}</th>\n        <th>{{ 'products.product.discount' | t }}</th>\n        <th>Price after discount</th>\n        {% if has_unit_price %}<th>Price per item</th>{% endif %}\n      </tr>\n    </thead>\n    <tbody>\n      <tr>\n        <td>{{ tier1_qty }}–{{ tier1_max }}</td>\n        <td>10 %</td>\n        <td>{{ price_10 }}</td>\n        {% if has_unit_price %}<td>{{ unit_price_10 }}</td>{% endif %}\n      </tr>\n      <tr>\n        <td>{{ tier2_qty }}+</td>\n        <td>20 %</td>\n        <td>{{ price_15 }}</td>\n        {% if has_unit_price %}<td>{{ unit_price_15 }}</td>{% endif %}\n      </tr>\n    </tbody>\n  </table>\n\n  {% assign _loc = request.locale.iso_code | default: 'en' %}\n{% if _loc == 'pt-PT' or _loc == 'pt' %}\n  {% assign _loc = 'pt' %}\n{% endif %}\n  <div class=\"bulk-order-notice\">\n    {% case _loc %}\n    {% when 'bg' %}\n      За по-големи поръчки (<strong>{{ bulk_qty }}+ бр.</strong>) се свържете с нас на\n    {% when 'hr' %}\n      Za veće narudžbe (<strong>{{ bulk_qty }}+ kom.</strong>) kontaktirajte nas na\n    {% when 'cs' %}\n      Pro větší objednávky (<strong>{{ bulk_qty }}+ ks</strong>) nás kontaktujte na\n    {% when 'da' %}\n      Ved større ordrer (<strong>{{ bulk_qty }}+ stk.</strong>) kontakt os på\n    {% when 'nl' %}\n      Voor grotere bestellingen (<strong>{{ bulk_qty }}+ stuks</strong>) neem contact op via\n    {% when 'et' %}\n      Suuremate tellimuste (<strong>{{ bulk_qty }}+ tk</strong>) korral võtke meiega ühendust\n    {% when 'fi' %}\n      Suuremmissa tilauksissa (<strong>{{ bulk_qty }}+ kpl</strong>) ota yhteyttä\n    {% when 'fr' %}\n      Pour les commandes en volume (<strong>{{ bulk_qty }}+ pcs</strong>), contactez-nous à\n    {% when 'de' %}\n      Bei größeren Bestellungen (<strong>{{ bulk_qty }}+ Stk.</strong>) kontaktieren Sie uns unter\n    {% when 'el' %}\n      Για μαζικές παραγγελίες (<strong>{{ bulk_qty }}+ τεμ.</strong>) επικοινωνήστε στο\n    {% when 'hu' %}\n      Nagyobb rendelésnél (<strong>{{ bulk_qty }}+ db</strong>) írjon nekünk:\n    {% when 'it' %}\n      Per ordini maggiori (<strong>{{ bulk_qty }}+ pz</strong>) contattaci a\n    {% when 'lv' %}\n      Lielākiem pasūtījumiem (<strong>{{ bulk_qty }}+ gab.</strong>) sazinieties ar mums:\n    {% when 'lt' %}\n      Didesniems užsakymams (<strong>{{ bulk_qty }}+ vnt.</strong>) susisiekite:\n    {% when 'pl' %}\n      Przy większych zamówieniach (<strong>{{ bulk_qty }}+ szt.</strong>) napisz do nas:\n    {% when 'pt' %}\n      Para encomendas maiores (<strong>{{ bulk_qty }}+ un.</strong>), contacte-nos em\n    {% when 'ro' %}\n      Pentru comenzi mai mari (<strong>{{ bulk_qty }}+ buc.</strong>) contactați-ne la\n    {% when 'sk' %}\n      Pri väčších objednávkach (<strong>{{ bulk_qty }}+ ks</strong>) nás kontaktujte na\n    {% when 'es' %}\n      Para pedidos mayores (<strong>{{ bulk_qty }}+ uds.</strong>), contáctenos en\n    {% when 'sv' %}\n      Vid större beställningar (<strong>{{ bulk_qty }}+ st</strong>) kontakta oss på\n    {% else %}\n      For bulk orders (<strong>{{ bulk_qty }}+ pcs</strong>), please contact us at\n    {% endcase %}\n    <a href=\"mailto:support@ekcos.eu\">support@ekcos.eu</a>\n  </div>\n</div>\n\n<style>\n  .quantity-discount-table { margin: 12px 0; }\n  .quantity-discount-table table { width: 100%; border-collapse: collapse; font-size: 0.9em; }\n  .quantity-discount-table th,\n  .quantity-discount-table td { border: 1px solid #e0e0e0; padding: 8px 12px; text-align: center; }\n  .quantity-discount-table th { background-color: #f5f5f5; font-weight: bold; }\n  \n  .bulk-order-notice {\n    margin-top: 8px;\n    padding: 10px 12px;\n    font-size: 0.85em;\n    color: #333;\n    background-color: #f9f9f9;\n    border: 1px solid #e0e0e0;\n    border-top: none;\n    text-align: center;\n  }\n  \n  .bulk-order-notice a {\n    color: #008cc9 !important;\n    text-decoration: underline !important;\n    font-weight: 600;\n  }\n</style>"
          }
