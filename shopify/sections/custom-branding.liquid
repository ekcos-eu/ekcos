<section class="cb" id="custom-branding" aria-labelledby="cb-hero-title">
  <div class="cb__hero">
    <div class="cb__wrap cb__hero-inner">
      <h1 class="cb__title" id="cb-hero-title">{{ cb_title }}</h1>
      <p class="cb__lead">{{ cb_lead }}</p>
      <p class="cb__intro">{{ cb_intro }}</p>
      <div class="cb__hero-actions">
        <a class="cb__btn cb__btn--primary" href="#inquiry">{{ cb_cta_label }}</a>
      </div>
    </div>
  </div>

  <div class="cb__wrap cb__section">
    <h2 class="cb__h2">{{ cb_why_title }}</h2>
    <div class="cb__grid cb__grid--3">
      <article class="cb__card">
        <h3 class="cb__h3">{{ cb_why_1_title }}</h3>
        <p>{{ cb_why_1_body }}</p>
      </article>
      <article class="cb__card">
        <h3 class="cb__h3">{{ cb_why_2_title }}</h3>
        <p>{{ cb_why_2_body }}</p>
      </article>
      <article class="cb__card">
        <h3 class="cb__h3">{{ cb_why_3_title }}</h3>
        <p>{{ cb_why_3_body }}</p>
      </article>
    </div>
  </div>

  <div class="cb__band">
    <div class="cb__wrap cb__section">
      <h2 class="cb__h2">{{ cb_ways_title }}</h2>
      <div class="cb__grid cb__grid--2">
        <article class="cb__card cb__card--accent">
          <h3 class="cb__h3">{{ cb_way_print_title }}</h3>
          <p>{{ cb_way_print_body }}</p>
        </article>
        <article class="cb__card cb__card--accent">
          <h3 class="cb__h3">{{ cb_way_cutout_title }}</h3>
          <p>{{ cb_way_cutout_body }}</p>
        </article>
      </div>
    </div>
  </div>

  <div class="cb__wrap cb__section">
    <h2 class="cb__h2">{{ cb_beyond_title }}</h2>
    <div class="cb__grid cb__grid--2">
      <article class="cb__card">
        <h3 class="cb__h3">{{ cb_beyond_pack_title }}</h3>
        <p>{{ cb_beyond_pack_body }}</p>
      </article>
      <article class="cb__card">
        <h3 class="cb__h3">{{ cb_beyond_mix_title }}</h3>
        <p>{{ cb_beyond_mix_body }}</p>
      </article>
    </div>
  </div>

  <div class="cb__band">
    <div class="cb__wrap cb__section">
      <h2 class="cb__h2">{{ cb_pricing_title }}</h2>
      <p class="cb__section-desc">{{ cb_pricing_desc }}</p>
      <div class="cb__grid cb__grid--3">
        <article class="cb__card cb__card--soft">
          <h3 class="cb__h3">{{ cb_card_1_title }}</h3>
          <ul class="cb__list">
            <li>{{ cb_card_1_item_1 }}</li>
            <li>{{ cb_card_1_item_2 }}</li>
          </ul>
        </article>
        <article class="cb__card cb__card--soft">
          <h3 class="cb__h3">{{ cb_card_2_title }}</h3>
          <ul class="cb__list">
            <li>{{ cb_card_2_item_1 }}</li>
            <li>{{ cb_card_2_item_2 }}</li>
          </ul>
        </article>
        <article class="cb__card cb__card--soft">
          <h3 class="cb__h3">{{ cb_card_3_title }}</h3>
          <ul class="cb__list">
            <li>{{ cb_card_3_item_1 }}</li>
            <li>{{ cb_card_3_item_2 }}</li>
            <li>{{ cb_card_3_item_3 }}</li>
            <li>{{ cb_card_3_item_4 }}</li>
          </ul>
        </article>
      </div>
    </div>
  </div>

  <div class="cb__wrap cb__section">
    <h2 class="cb__h2">{{ cb_good_title }}</h2>
    <ul class="cb__bullets">
      <li>{{ cb_good_1 }}</li>
      <li>{{ cb_good_2 }}</li>
      <li>{{ cb_good_3 }}</li>
      <li>{{ cb_good_4 }}</li>
      <li>{{ cb_good_5 }}</li>
      <li>{{ cb_good_6 }}</li>
      <li>{{ cb_good_7 }}</li>
    </ul>
  </div>

  <div class="cb__wrap cb__section" id="inquiry">
    <h2 class="cb__h2">{{ cb_form_title }}</h2>
    <p class="cb__section-desc">{{ cb_form_desc }}</p>

    <div class="cb__form-shell">
      {% form 'contact', id: 'custom-branding-form', class: 'cb__form' %}
        {% if form.posted_successfully? %}
          <p class="cb__alert cb__alert--success" role="status">
            {{ cb_form_success }}
          </p>
        {% endif %}

        {% if form.errors %}
          <div class="cb__alert cb__alert--error" role="alert">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <input type="hidden" name="contact[form_name]" value="Custom Branding inquiry">

        <div class="cb__form-grid">
          <div class="cb__field">
            <label for="cb-name">{{ cb_label_name }}</label>
            <input
              id="cb-name"
              type="text"
              name="contact[name]"
              autocomplete="name"
              required
              value="{% if form.name %}{{ form.name }}{% endif %}"
            >
          </div>

          <div class="cb__field">
            <label for="cb-company">{{ cb_label_company }}</label>
            <input
              id="cb-company"
              type="text"
              name="contact[company]"
              autocomplete="organization"
              required
              value="{% if form.company %}{{ form.company }}{% endif %}"
            >
          </div>

          <div class="cb__field">
            <label for="cb-email">{{ cb_label_email }}</label>
            <input
              id="cb-email"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              value="{% if form.email %}{{ form.email }}{% endif %}"
            >
          </div>

          <div class="cb__field">
            <label for="cb-phone">{{ cb_label_phone }}</label>
            <input
              id="cb-phone"
              type="tel"
              name="contact[phone]"
              autocomplete="tel"
              value="{% if form.phone %}{{ form.phone }}{% endif %}"
            >
          </div>

          <div class="cb__field cb__field--full">
            <span class="cb__products-label" id="cb-products-label">{{ cb_label_products }}</span>
            <p class="cb__field-hint">{{ cb_products_hint }}</p>

            <div
              class="cb__products"
              data-cb-products
              role="group"
              aria-labelledby="cb-products-label"
            >
              {% comment %} Items separated by ;;  fields: name|image {% endcomment %}
              {% assign branding_products = 'xcrën HD|cb-xcreen-hd.png;;ëkcoscreen|cb-ekcoscreen.png;;powër screen|cb-powerscreen.png;;basic scrëen|cb-basic-screen.png;;üro lite|cb-urolite.png;;ëkco clip|cb-ekcoclip.png;;frësh drop|cb-fresh-drop.png;;ëz trap|cb-ez-trap.png;;xcrën puck|cb-xcreen-puck.png' | split: ';;' %}
              {% for item in branding_products %}
                {% assign parts = item | split: '|' %}
                {% assign product_name = parts[0] %}
                {% assign product_image = parts[1] %}
                {% assign product_id = product_name | handleize %}
                <div class="cb__product-row" data-cb-product-row>
                  <div class="cb__product-info">
                    <img
                      class="cb__product-thumb"
                      src="{{ product_image | asset_url }}"
                      alt="{{ product_name }}"
                      width="56"
                      height="56"
                      loading="lazy"
                    >
                    <span class="cb__product-name">{{ product_name }}</span>
                  </div>
                  <div class="cb__product-qty">
                    <label class="cb__product-qty-label" for="cb-qty-{{ product_id }}">
                      {{ cb_label_quantity }}
                    </label>
                    <input
                      id="cb-qty-{{ product_id }}"
                      class="cb__product-qty-input"
                      type="number"
                      min="0"
                      step="1"
                      inputmode="numeric"
                      placeholder="0"
                      data-cb-product-qty
                      data-product-name="{{ product_name }}"
                    >
                  </div>
                </div>
              {% endfor %}
            </div>

            <input type="hidden" name="contact[products]" id="cb-products" value="" data-cb-products-hidden>
            <input type="hidden" name="contact[quantity]" id="cb-quantity-total" value="" data-cb-quantity-hidden>
          </div>

          <div class="cb__field cb__field--full">
            <label for="cb-message">{{ cb_label_message }}</label>
            <textarea
              id="cb-message"
              name="contact[body]"
              rows="5"
              required
            >{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
        </div>

        <button type="submit" class="cb__btn cb__btn--primary cb__btn--submit">
          {{ cb_submit_label }}
        </button>
      {% endform %}
    </div>
  </div>
</section>

<style>
  /*
    Theme uses Dawn-style root: html { font-size: calc(var(--font-body-scale) * 62.5%) }
    so 1rem ≈ 10px. Body copy on the shop is typically 1.5–1.6rem (15–16px).
    All sizes below follow that scale.
  */
  .cb {
    --cb-blue: #0F68B2;
    --cb-ink: #1a1a1a;
    --cb-body: #2c2c2c;
    --cb-muted: #555555;
    --cb-line: #e5e5e5;
    --cb-soft: #f7f7f7;
    --cb-band: #f5f8fb;
    --cb-white: #ffffff;
    --cb-radius: 1.2rem;
    color: var(--cb-body);
    background: var(--cb-white);
    font-family: var(--font-body-family, inherit);
    font-style: var(--font-body-style, normal);
    font-weight: var(--font-body-weight, 400);
    font-size: 1.6rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  .cb *,
  .cb *::before,
  .cb *::after {
    box-sizing: border-box;
  }

  .cb__wrap {
    width: min(115.2rem, 100%);
    margin-inline: auto;
    /* Extra left inset clears fixed social / promo rail on Eurus */
    padding-inline: 6.8rem 1.6rem;
  }

  .cb__hero {
    background:
      radial-gradient(120% 80% at 50% -20%, rgba(15, 104, 178, 0.14), transparent 55%),
      linear-gradient(180deg, #eef5fb 0%, #ffffff 78%);
    padding: 6rem 0 4.5rem;
    text-align: left;
  }

  .cb__title {
    margin: 0;
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 700);
    font-size: 3.6rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--cb-ink);
    text-wrap: balance;
  }

  .cb__lead {
    margin: 1.6rem 0 0;
    font-family: var(--font-heading-family, inherit);
    font-size: 2.4rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--cb-blue);
    text-wrap: balance;
  }

  .cb__intro {
    margin: 1.8rem 0 0;
    font-size: 1.7rem;
    line-height: 1.7;
    color: var(--cb-body);
    text-align: justify;
  }

  .cb__hero-actions {
    margin-top: 2.8rem;
    display: flex;
    justify-content: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .cb__section {
    padding: 5.5rem 0;
  }

  .cb__band {
    background: var(--cb-band);
  }

  .cb__h2 {
    margin: 0;
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 700);
    font-size: 2.4rem;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--cb-ink);
  }

  #inquiry .cb__h2 {
    color: var(--cb-ink);
    display: inline-block;
    padding-bottom: 0.5rem;
    border-bottom: 0.3rem solid var(--cb-blue);
  }

  .cb__h3 {
    margin: 0;
    font-family: var(--font-heading-family, inherit);
    font-style: var(--font-heading-style, normal);
    font-weight: var(--font-heading-weight, 700);
    font-size: 2rem;
    line-height: 1.3;
    color: var(--cb-ink);
  }

  .cb__section-desc {
    margin: 1.2rem 0 0;
    max-width: 70rem;
    font-size: 1.7rem;
    line-height: 1.65;
    color: var(--cb-body);
  }

  .cb__grid {
    display: grid;
    gap: 2rem;
    margin-top: 2.8rem;
  }

  .cb__grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cb__grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .cb__card {
    border: 0.1rem solid var(--cb-line);
    border-radius: var(--cb-radius);
    background: var(--cb-white);
    padding: 2.4rem;
  }

  .cb__card p {
    margin: 1.2rem 0 0;
    color: var(--cb-body);
    font-size: 1.6rem;
    line-height: 1.65;
  }

  .cb__card--soft {
    background: var(--cb-soft);
  }

  .cb__card--accent {
    border-color: rgba(15, 104, 178, 0.22);
  }

  .cb__list,
  .cb__bullets {
    margin: 1.4rem 0 0;
    padding: 0;
    list-style: none;
  }

  .cb__list li,
  .cb__bullets li {
    position: relative;
    padding-left: 1.6rem;
    margin-top: 1rem;
    color: var(--cb-body);
    font-size: 1.6rem;
    line-height: 1.65;
  }

  .cb__list li::before,
  .cb__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--cb-blue);
  }

  .cb__table-wrap {
    margin-top: 2.4rem;
    overflow-x: auto;
    border: 0.1rem solid var(--cb-line);
    border-radius: var(--cb-radius);
    background: var(--cb-white);
  }

  .cb__table {
    width: 100%;
    border-collapse: collapse;
    min-width: 42rem;
    font-size: 1.6rem;
  }

  .cb__table th,
  .cb__table td {
    text-align: left;
    padding: 1.4rem 1.6rem;
    border-bottom: 0.1rem solid var(--cb-line);
  }

  .cb__table th {
