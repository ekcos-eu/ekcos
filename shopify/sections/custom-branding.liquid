    font-size: 1.5rem;
    line-height: 1.55;
    color: var(--cb-muted);
  }

  .cb__form-shell {
    margin-top: 2.8rem;
    max-width: 72rem;
    border: 0;
    border-radius: 0;
    background: transparent;
    padding: 0;
  }

  .cb__form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem 2.2rem;
  }

  .cb__field {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .cb__field--full {
    grid-column: 1 / -1;
  }

  .cb__field label {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cb-ink);
  }

  .cb__field input,
  .cb__field textarea {
    width: 100%;
    border: 0.1rem solid #cfcfcf;
    border-radius: 0.8rem;
    background: var(--cb-white);
    color: var(--cb-ink);
    padding: 1.4rem 1.5rem;
    font: inherit;
    font-size: 1.6rem;
  }

  .cb__field textarea {
    resize: vertical;
    min-height: 14rem;
  }

  .cb__field input:focus,
  .cb__field textarea:focus {
    outline: none;
    border-color: var(--cb-blue);
    box-shadow: 0 0 0 0.2rem rgba(15, 104, 178, 0.2);
  }

  .cb__field-hint {
    margin: 0.4rem 0 1.4rem;
    font-size: 1.4rem;
    color: var(--cb-muted);
  }

  .cb__products-label {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--cb-ink);
  }

  .cb__products {
    display: grid;
    gap: 0;
    border: 0.1rem solid var(--cb-line);
    border-radius: var(--cb-radius);
    background: var(--cb-white);
    overflow: hidden;
  }

  .cb__product-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1.6rem;
    align-items: center;
    padding: 1.4rem 1.6rem;
    border-bottom: 0.1rem solid var(--cb-line);
  }

  .cb__product-row:last-child {
    border-bottom: 0;
  }

  .cb__product-row.is-active {
    background: rgba(15, 104, 178, 0.04);
  }

  .cb__product-info {
