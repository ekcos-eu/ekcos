{% assign vat_eligibility_body = '0% VAT (reverse charge) applies to VAT-registered businesses in all EU countries except the Czech Republic. Because we invoice under our Czech VAT ID (DIČ), Czech companies cannot use reverse charge and standard Czech VAT applies to their orders.' %}
{% assign vat_step_1_title = '1. Enter your shipping and billing information' %}
{% assign vat_step_1_body = 'When you proceed to checkout from your shopping cart, first fill in your standard contact and delivery details.' %}
{% assign vat_step_2_title = '2. Fill in your company name and VAT ID' %}
{% assign vat_step_2_body = 'To trigger the VAT validation system, fill in the company details fields carefully.' %}
{% assign vat_step_2_item_1 = 'Your official Company Name.' %}
{% assign vat_step_2_item_2 = 'Your valid EU VAT ID including the country prefix, for example DE123456789, FR123456789, or IT123456789. Czech VAT IDs (CZ…) are not eligible for reverse charge.' %}
