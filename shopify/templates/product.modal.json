        "collapsible_description_main": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign _loc = request.locale.iso_code | default: 'en'\n  if _loc == 'pt-PT' or _loc == 'pt'\n    assign _loc = 'pt'\n  endif\n  case _loc\n    when 'cs'\n      assign desc_heading = 'Popis produktu'\n    when 'sk'\n      assign desc_heading = 'Popis produktu'\n    when 'de'\n      assign desc_heading = 'Produktbeschreibung'\n    when 'pl'\n      assign desc_heading = 'Opis produktu'\n    when 'fr'\n      assign desc_heading = 'Description'\n    when 'es'\n      assign desc_heading = 'Descripción'\n    when 'it'\n      assign desc_heading = 'Descrizione'\n    when 'nl'\n      assign desc_heading = 'Beschrijving'\n    when 'sv'\n      assign desc_heading = 'Beskrivning'\n    when 'da'\n      assign desc_heading = 'Beskrivelse'\n    when 'fi'\n      assign desc_heading = 'Kuvaus'\n    when 'hu'\n      assign desc_heading = 'Termékleírás'\n    when 'ro'\n      assign desc_heading = 'Descriere'\n    when 'bg'\n      assign desc_heading = 'Описание'\n    when 'hr'\n      assign desc_heading = 'Opis proizvoda'\n    when 'el'\n      assign desc_heading = 'Περιγραφή'\n    when 'et'\n      assign desc_heading = 'Kirjeldus'\n    when 'lv'\n      assign desc_heading = 'Apraksts'\n    when 'lt'\n      assign desc_heading = 'Aprašymas'\n    when 'pt'\n      assign desc_heading = 'Descrição'\n    else\n      assign desc_heading = 'Description'\n  endcase\n-%}\n{%- if product.description != blank -%}\n  <accordion-tab class=\"product__accordion accordion\">\n    <details>\n      <summary>\n        <span class=\"summary__title\">\n          <span class=\"accordion__title\">{{ desc_heading }}</span>\n        </span>\n        {% render 'icon', icon: 'caret' %}\n      </summary>\n      <div class=\"accordion__content rte\">\n        {{ product.description }}\n      </div>\n    </details>\n  </accordion-tab>\n{%- endif -%}\n<style>\n  /* Collapse double border/gap between Description and next accordion (Shipping) */\n  .custom__liquid:has(.product__accordion) + .product__accordion {\n    margin-top: 0 !important;\n    border-top: none !important;\n  }\n  .custom__liquid:has(.product__accordion) .product__accordion {\n    margin-bottom: 0;\n  }\n</style>"
          }
        },
        "custom_liquid_complementary_bases": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Compact \"Don't forget the base\" for lookbook quick-view modal.\n  Uses Search & Discovery complementary product metafields (same as PDP).\n{%- endcomment -%}\n{%- liquid\n  assign is_base = false\n  if product.handle contains '-base' or product.title contains ' base'\n    assign is_base = true\n  endif\n\n  assign complementary_list = product.metafields['shopify--discovery--product_recommendation'].complementary_products.value\n\n  assign _loc = request.locale.iso_code | default: 'en'\n  if _loc == 'pt-PT' or _loc == 'pt'\n    assign _loc = 'pt'\n  endif\n  case _loc\n    when 'cs'\n      assign base_heading = 'Nezapomeňte na základnu'\n      assign base_added = 'Přidáno'\n    when 'sk'\n      assign base_heading = 'Nezabudnite na základňu'\n      assign base_added = 'Pridané'\n    when 'de'\n      assign base_heading = 'Basis nicht vergessen'\n      assign base_added = 'Hinzugefügt'\n    when 'pl'\n      assign base_heading = 'Nie zapomnij o podstawie'\n      assign base_added = 'Dodano'\n    when 'fr'\n      assign base_heading = \"N'oubliez pas la base\"\n      assign base_added = 'Ajouté'\n    when 'es'\n      assign base_heading = 'No olvides la base'\n      assign base_added = 'Añadido'\n    when 'it'\n      assign base_heading = 'Non dimenticare la base'\n      assign base_added = 'Aggiunto'\n    when 'nl'\n      assign base_heading = 'Vergeet de basis niet'\n      assign base_added = 'Toegevoegd'\n    when 'sv'\n      assign base_heading = 'Glöm inte basen'\n      assign base_added = 'Tillagd'\n    when 'da'\n      assign base_heading = 'Glem ikke basen'\n      assign base_added = 'Tilføjet'\n    when 'fi'\n      assign base_heading = 'Älä unohda jalustaa'\n      assign base_added = 'Lisätty'\n    when 'hu'\n      assign base_heading = 'Ne feledd az alapot'\n      assign base_added = 'Hozzáadva'\n    when 'ro'\n      assign base_heading = 'Nu uita baza'\n      assign base_added = 'Adăugat'\n    when 'bg'\n      assign base_heading = 'Не забравяйте основата'\n      assign base_added = 'Добавено'\n    when 'hr'\n      assign base_heading = 'Ne zaboravite bazu'\n      assign base_added = 'Dodano'\n    when 'el'\n      assign base_heading = 'Μην ξεχάσετε τη βάση'\n      assign base_added = 'Προστέθηκε'\n    when 'et'\n      assign base_heading = 'Ärge unustage alust'\n      assign base_added = 'Lisatud'\n    when 'lv'\n      assign base_heading = 'Neaizmirstiet pamatni'\n      assign base_added = 'Pievienots'\n    when 'lt'\n      assign base_heading = 'Nepamirškite pagrindo'\n      assign base_added = 'Pridėta'\n    when 'pt'\n      assign base_heading = 'Não se esqueça da base'\n      assign base_added = 'Adicionado'\n    else\n      assign base_heading = \"Don't forget the base\"\n      assign base_added = 'Added'\n  endcase\n-%}\n{%- if is_base == false and complementary_list != blank and complementary_list.count > 0 -%}\n  <div class=\"modal-complementary-bases\" data-modal-complementary-bases>\n    <p class=\"modal-complementary-bases__heading\">{{ base_heading }}</p>\n    <ul class=\"modal-complementary-bases__list\" role=\"list\">\n      {%- for base_product in complementary_list limit: 4 -%}\n        {%- if base_product == blank -%}\n          {%- continue -%}\n        {%- endif -%}\n        {%- assign base_variant = base_product.selected_or_first_available_variant -%}\n        <li class=\"modal-complementary-bases__item\" role=\"listitem\">\n          {%- if base_product.featured_media -%}\n            <img\n              class=\"modal-complementary-bases__image\"\n              src=\"{{ base_product.featured_media | image_url: width: 96 }}\"\n              alt=\"{{ base_product.title | escape }}\"\n              width=\"48\"\n              height=\"48\"\n              loading=\"lazy\"\n            >\n          {%- endif -%}\n          <div class=\"modal-complementary-bases__info\">\n            <span class=\"modal-complementary-bases__title\">{{ base_product.title }}</span>\n            {%- if base_variant -%}\n              <span class=\"modal-complementary-bases__price\">{{ base_variant.price | money }}</span>\n            {%- endif -%}\n            {%- if base_product.available and base_variant -%}\n              <button\n                type=\"button\"\n                class=\"modal-complementary-bases__atc\"\n                data-modal-base-atc\n                data-variant-id=\"{{ base_variant.id }}\"\n                data-added-label=\"{{ base_added | escape }}\"\n              >\n                {{ 'products.product.add_to_cart' | t }}\n              </button>\n            {%- else -%}\n              <span class=\"modal-complementary-bases__soldout\">{{ 'products.product.sold_out' | t }}</span>\n            {%- endif -%}\n          </div>\n        </li>\n      {%- endfor -%}\n    </ul>\n  </div>\n  <script>\n    (function () {\n      if (window.__ekcosModalBaseAtcBound) return;\n      window.__ekcosModalBaseAtcBound = true;\n\n      function sectionInnerHTML(html, selector) {\n        var doc = new DOMParser().parseFromString(html, 'text/html');\n        var node = doc.querySelector(selector || '.shopify-section');\n        return node ? node.innerHTML : '';\n      }\n\n      function updateCartBadges(parsedState) {\n        var miniCart = document.querySelector('mini-cart');\n        if (!miniCart || typeof miniCart.getSectionsToRender !== 'function') return;\n        miniCart.getSectionsToRender().forEach(function (section) {\n          var el = document.getElementById(section.id);\n          var sectionHtml = parsedState.sections && parsedState.sections[section.id];\n          if (!el || !sectionHtml) return;\n          el.innerHTML = sectionInnerHTML(sectionHtml, section.selector);\n        });\n      }\n\n      function cartAddConfig() {\n        var config = typeof fetchConfig === 'function'\n          ? fetchConfig('javascript')\n          : {\n              method: 'POST',\n              headers: {\n                'Content-Type': 'application/json',\n                Accept: 'application/javascript',\n                'X-Requested-With': 'XMLHttpRequest'\n              }\n            };\n        return config;\n      }\n\n      document.addEventListener('click', function (event) {\n        var button = event.target.closest('[data-modal-base-atc]');\n        if (!button) return;\n        event.preventDefault();\n        event.stopPropagation();\n\n        var variantId = button.getAttribute('data-variant-id');\n        if (!variantId || button.hasAttribute('disabled')) return;\n\n        var miniCart = document.querySelector('mini-cart');\n        var sections = miniCart && typeof miniCart.getSectionsToRender === 'function'\n          ? miniCart.getSectionsToRender().map(function (section) { return section.id; })\n          : ['cart-icon-bubble', 'mobile-cart-icon-bubble', 'mini-cart'];\n\n        var label = button.textContent;\n        var addedLabel = button.getAttribute('data-added-label') || 'Added';\n        button.setAttribute('disabled', 'true');\n        button.classList.add('is-loading');\n\n        var config = cartAddConfig();\n        config.body = JSON.stringify({\n          id: Number(variantId),\n          quantity: 1,\n          sections: sections,\n          sections_url: window.location.pathname\n        });\n\n        var cartAddUrl = (window.theme && theme.routes && theme.routes.cart_add_url) || '/cart/add.js';\n\n        fetch(cartAddUrl, config)\n          .then(function (response) { return response.json(); })\n          .then(function (parsedState) {\n            if (parsedState.status === 422) {\n              button.textContent = label;\n              return;\n            }\n            updateCartBadges(parsedState);\n            button.textContent = addedLabel;\n            button.classList.add('is-added');\n            setTimeout(function () {\n              button.textContent = label;\n              button.classList.remove('is-added');\n            }, 1600);\n          })\n          .catch(function (err) {\n            console.error(err);\n            button.textContent = label;\n          })\n          .finally(function () {\n            button.classList.remove('is-loading');\n            button.removeAttribute('disabled');\n          });\n      });\n    })();\n  </script>\n  <style>\n    .modal-complementary-bases {\n      margin: 0 0 1.1rem;\n      padding: 0.85rem 0 0;\n      border-top: 1px solid #e5e7eb;\n    }\n    .modal-complementary-bases__heading {\n      margin: 0 0 0.65rem;\n      font-size: 0.85rem;\n      font-weight: 600;\n      letter-spacing: 0.02em;\n      text-transform: uppercase;\n      color: #333;\n    }\n    .modal-complementary-bases__list {\n      list-style: none;\n      margin: 0;\n      padding: 0;\n      display: grid;\n      grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr));\n      gap: 0.65rem;\n    }\n    .modal-complementary-bases__item {\n      display: flex;\n      gap: 0.55rem;\n      align-items: flex-start;\n      min-width: 0;\n    }\n    .modal-complementary-bases__image {\n      width: 48px;\n      height: 48px;\n      object-fit: cover;\n      border-radius: 6px;\n      background: #f5f5f5;\n      flex: 0 0 auto;\n    }\n    .modal-complementary-bases__info {\n      display: flex;\n      flex-direction: column;\n      gap: 0.15rem;\n      min-width: 0;\n    }\n    .modal-complementary-bases__title {\n      font-size: 0.8rem;\n      line-height: 1.25;\n      font-weight: 500;\n    }\n    .modal-complementary-bases__price {\n      font-size: 0.8rem;\n      color: #333;\n    }\n    .modal-complementary-bases__atc {\n      margin-top: 0.2rem;\n      align-self: flex-start;\n      padding: 0.2rem 0;\n      min-height: 0;\n      min-width: 0;\n      border: 0;\n      background: transparent;\n      box-shadow: none;\n      text-decoration: underline;\n      text-underline-offset: 2px;\n      font-size: 0.75rem;\n      font-weight: 600;\n      letter-spacing: 0.02em;\n      text-transform: uppercase;\n      color: #0F68B2;\n      cursor: pointer;\n    }\n    .modal-complementary-bases__atc:hover {\n      color: #0b4f87;\n    }\n    .modal-complementary-bases__atc.is-loading {\n      opacity: 0.6;\n      cursor: wait;\n    }\n    .modal-complementary-bases__atc.is-added {\n      text-decoration: none;\n      color: #0F68B2;\n    }\n    .modal-complementary-bases__soldout {\n      font-size: 0.75rem;\n      color: #888;\n    }\n  </style>\n{%- endif -%}\n"
          }
        }
      },
      "block_order": [
        "subtitle",
