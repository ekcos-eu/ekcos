        "custom_liquid_color_swatches": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- comment -%}\n  Sibling color/scent picker for quick-view modal.\n  Uses the smallest product-family collection (not all / category hubs).\n{%- endcomment -%}\n{%- liquid\n  assign family = nil\n  assign skip_handles = 'all,urinal-screens,air-fresheners,other-products,frontpage' | split: ','\n  for c in product.collections\n    assign skip = false\n    for h in skip_handles\n      if c.handle == h\n        assign skip = true\n        break\n      endif\n    endfor\n    if skip\n      continue\n    endif\n    if family == nil or c.all_products_count < family.all_products_count\n      assign family = c\n    endif\n  endfor\n\n  assign is_base = false\n  if product.handle contains '-base' or product.title contains ' base'\n    assign is_base = true\n  endif\n\n  assign sibling_count = 0\n  if family != nil\n    for p in family.products\n      if p.available == false and p.selected_or_first_available_variant == nil\n        continue\n      endif\n      assign p_is_base = false\n      if p.handle contains '-base' or p.title contains ' base'\n        assign p_is_base = true\n      endif\n      if is_base and p_is_base == false\n        continue\n      endif\n      if is_base == false and p_is_base\n        continue\n      endif\n      assign sibling_count = sibling_count | plus: 1\n    endfor\n  endif\n-%}\n{%- if family != nil and sibling_count > 1 -%}\n  {%- liquid\n    assign _loc = request.locale.iso_code | default: 'en'\n    if _loc == 'pt-PT' or _loc == 'pt'\n      assign _loc = 'pt'\n    endif\n    case _loc\n      when 'cs'\n        assign color_label = 'Barva / vůně'\n      when 'sk'\n        assign color_label = 'Farba / vôňa'\n      when 'de'\n        assign color_label = 'Farbe / Duft'\n      when 'pl'\n        assign color_label = 'Kolor / zapach'\n      when 'fr'\n        assign color_label = 'Couleur / parfum'\n      when 'es'\n        assign color_label = 'Color / aroma'\n      when 'it'\n        assign color_label = 'Colore / fragranza'\n      when 'nl'\n        assign color_label = 'Kleur / geur'\n      when 'sv'\n        assign color_label = 'Färg / doft'\n      when 'da'\n        assign color_label = 'Farve / duft'\n      when 'fi'\n        assign color_label = 'Väri / tuoksu'\n      when 'hu'\n        assign color_label = 'Szín / illat'\n      when 'ro'\n        assign color_label = 'Culoare / aromă'\n      when 'bg'\n        assign color_label = 'Цвят / аромат'\n      when 'hr'\n        assign color_label = 'Boja / miris'\n      when 'el'\n        assign color_label = 'Χρώμα / άρωμα'\n      when 'et'\n        assign color_label = 'Värv / lõhn'\n      when 'lv'\n        assign color_label = 'Krāsa / smarža'\n      when 'lt'\n        assign color_label = 'Spalva / kvapas'\n      when 'pt'\n        assign color_label = 'Cor / aroma'\n      else\n        assign color_label = 'Color / scent'\n    endcase\n  -%}\n  <div class=\"modal-color-swatches\" data-modal-color-swatches>\n    <p class=\"modal-color-swatches__label\">{{ color_label }}</p>\n    <div class=\"modal-color-swatches__list\" role=\"list\">\n      {%- for p in family.products -%}\n        {%- liquid\n          assign p_is_base = false\n          if p.handle contains '-base' or p.title contains ' base'\n            assign p_is_base = true\n          endif\n          if is_base and p_is_base == false\n            continue\n          endif\n          if is_base == false and p_is_base\n            continue\n          endif\n          assign label = p.title\n          if p.title contains ' / '\n            assign title_parts = p.title | split: ' / '\n            assign before = title_parts.first | split: ' '\n            assign after = title_parts.last | split: ',' | first | strip\n            if before.size > 1\n              assign label = before.last | append: ' / ' | append: after\n            endif\n          endif\n        -%}\n        <a\n          role=\"listitem\"\n          href=\"{{ p.url }}\"\n          class=\"modal-color-swatches__item{% if p.id == product.id %} is-active{% endif %}\"\n          data-modal-product-url=\"{{ p.url }}\"\n          title=\"{{ p.title | escape }}\"\n          aria-label=\"{{ p.title | escape }}\"\n          aria-current=\"{% if p.id == product.id %}true{% else %}false{% endif %}\"\n        >\n          {%- if p.featured_media -%}\n            <img\n              src=\"{{ p.featured_media | image_url: width: 96 }}\"\n              alt=\"{{ p.title | escape }}\"\n              width=\"48\"\n              height=\"48\"\n              loading=\"lazy\"\n            >\n          {%- endif -%}\n          <span class=\"modal-color-swatches__name\">{{ label }}</span>\n        </a>\n      {%- endfor -%}\n    </div>\n  </div>\n  <style>\n    .modal-color-swatches { margin: 0 0 1.2rem; }\n    .modal-color-swatches__label {\n      margin: 0 0 0.6rem;\n      font-size: 0.85rem;\n      font-weight: 600;\n      letter-spacing: 0.02em;\n      text-transform: uppercase;\n      color: #333;\n    }\n    .modal-color-swatches__list {\n      display: flex;\n      flex-wrap: wrap;\n      gap: 0.5rem;\n    }\n    .modal-color-swatches__item {\n      display: inline-flex;\n      align-items: center;\n      gap: 0.45rem;\n      max-width: 100%;\n      padding: 0.25rem 0.55rem 0.25rem 0.25rem;\n      border: 1px solid #d9d9d9;\n      border-radius: 999px;\n      text-decoration: none;\n      color: inherit;\n      background: #fff;\n      line-height: 1.2;\n    }\n    .modal-color-swatches__item img {\n      width: 36px;\n      height: 36px;\n      object-fit: cover;\n      border-radius: 50%;\n      display: block;\n      background: #f5f5f5;\n    }\n    .modal-color-swatches__name {\n      font-size: 0.8rem;\n      white-space: nowrap;\n      overflow: hidden;\n      text-overflow: ellipsis;\n      max-width: 9.5rem;\n    }\n    .modal-color-swatches__item.is-active {\n      border-color: #0F68B2;\n      box-shadow: 0 0 0 1px #0F68B2;\n    }\n    .modal-color-swatches__item:hover {\n      border-color: #0F68B2;\n    }\n  </style>\n  <script>\n    (function () {\n      if (window.__ekcosModalColorSwatchesBound) return;\n      window.__ekcosModalColorSwatchesBound = true;\n\n      function setInnerHTML(element, html) {\n        element.innerHTML = html;\n        element.querySelectorAll('script').forEach(function (oldScriptTag) {\n          var newScriptTag = document.createElement('script');\n          Array.from(oldScriptTag.attributes).forEach(function (attribute) {\n            newScriptTag.setAttribute(attribute.name, attribute.value);\n          });\n          newScriptTag.appendChild(document.createTextNode(oldScriptTag.innerHTML));\n          oldScriptTag.parentNode.replaceChild(newScriptTag, oldScriptTag);\n        });\n      }\n\n      document.addEventListener('click', function (event) {\n        var link = event.target.closest('[data-modal-product-url]');\n        if (!link) return;\n        var content = link.closest('.quick-view__content');\n        if (!content) return;\n        event.preventDefault();\n        var productUrl = link.getAttribute('data-modal-product-url').split('?')[0];\n        content.classList.remove('hide-cover');\n        fetch(productUrl + '?view=modal')\n          .then(function (response) { return response.text(); })\n          .then(function (responseText) {\n            var next = new DOMParser()\n              .parseFromString(responseText, 'text/html')\n              .querySelector('.quick-view__content');\n            if (!next) return;\n            setInnerHTML(content, next.innerHTML);\n            if (window.Shopify && Shopify.PaymentButton) Shopify.PaymentButton.init();\n            content.classList.add('hide-cover');\n            var qv = content.closest('quick-view');\n            if (qv) qv.dataset.productUrl = productUrl;\n            document.dispatchEvent(new CustomEvent('quickview:loaded', { detail: { productUrl: productUrl } }));\n          })\n          .catch(function (err) { console.error(err); content.classList.add('hide-cover'); });\n      });\n    })();\n  </script>\n{%- endif -%}\n"
          }
        },
        "custom_liquid_short_description": {
          "type": "custom_liquid",
