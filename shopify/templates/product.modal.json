            "custom_liquid": "{% if product.metafields.custom.short_description %}\n  <div class=\"product-short-description rte\">\n    {{ product.metafields.custom.short_description | metafield_tag }}\n  </div>\n  <style>\n    .product-short-description { margin: 0 0 1rem; }\n    .product-short-description p { margin: 0 0 0.75em; }\n    .product-short-description p:last-child { margin-bottom: 0; }\n  </style>\n{% endif %}"
          }
