        "collapsible_description_main": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign _loc = request.locale.iso_code | default: 'en'\n  if _loc == 'pt-PT' or _loc == 'pt'\n    assign _loc = 'pt'\n  endif\n  case _loc\n    when 'cs'\n      assign desc_heading = 'Popis produktu'\n    when 'sk'\n      assign desc_heading = 'Popis produktu'\n    when 'de'\n      assign desc_heading = 'Produktbeschreibung'\n    when 'pl'\n      assign desc_heading = 'Opis produktu'\n    when 'fr'\n      assign desc_heading = 'Description'\n    when 'es'\n      assign desc_heading = 'Descripción'\n    when 'it'\n      assign desc_heading = 'Descrizione'\n    when 'nl'\n      assign desc_heading = 'Beschrijving'\n    when 'sv'\n      assign desc_heading = 'Beskrivning'\n    when 'da'\n      assign desc_heading = 'Beskrivelse'\n    when 'fi'\n      assign desc_heading = 'Kuvaus'\n    when 'hu'\n      assign desc_heading = 'Termékleírás'\n    when 'ro'\n      assign desc_heading = 'Descriere'\n    when 'bg'\n      assign desc_heading = 'Описание'\n    when 'hr'\n      assign desc_heading = 'Opis proizvoda'\n    when 'el'\n      assign desc_heading = 'Περιγραφή'\n    when 'et'\n      assign desc_heading = 'Kirjeldus'\n    when 'lv'\n      assign desc_heading = 'Apraksts'\n    when 'lt'\n      assign desc_heading = 'Aprašymas'\n    when 'pt'\n      assign desc_heading = 'Descrição'\n    else\n      assign desc_heading = 'Description'\n  endcase\n-%}\n{%- if product.description != blank -%}\n  <accordion-tab class=\"product__accordion accordion\">\n    <details>\n      <summary>\n        <span class=\"summary__title\">\n          <span class=\"accordion__title\">{{ desc_heading }}</span>\n        </span>\n        {% render 'icon', icon: 'caret' %}\n      </summary>\n      <div class=\"accordion__content rte\">\n        {{ product.description }}\n      </div>\n    </details>\n  </accordion-tab>\n{%- endif -%}"
          }
